@using EventEdu.Webui.ViewsModels
@model AboutIndexVM

@{
    ViewData["Title"] = "About Section List";
}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">About Section Table</h5>
    <a href="@Url.Action("AddAboutSection", "AboutSection")" class="btn btn-primary mb-3">Add New About Section</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>About section image</th>
                    <th>Title</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                
                    @if (@Model.AboutSectionDetail.IsDeleted)
                    {
                        <tr class="AboutSectionRow" style="background:plum; color:#fff;">
                            <td>@Model.AboutSectionDetail.LanguageId</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@Model.AboutSection.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @@Model.AboutSection.ImagePath)" /></div<td>
                            <td>@Model.AboutSectionDetail.Title</td>
                            <td>@Model.AboutSectionDetail.Description</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="AboutSection" asp-action="RestoreAboutSection" asp-route-id="@Model.AboutSectionDetail.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this About Section?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Restore</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="AboutSectionRow">
                             <td>@Model.AboutSectionDetail.LanguageId</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@Model.AboutSection.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @@Model.AboutSection.ImagePath)" /></div<td>
                            <td>@Model.AboutSectionDetail.Title</td>
                            <td>@Model.AboutSectionDetail.Description</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                         <a asp-controller="AboutSection" asp-action="EditAboutSection" asp-route-id="@Model.AboutSectionDetail.Id" class="dropdown-item">
                                            <i class="ri-pencil-line me-2"></i>Edit </a>
                                        <form asp-controller="AboutSection" asp-action="DeleteAboutSection" asp-route-id="@Model.AboutSectionDetail.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this About Section?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!--/ Basic Bootstrap Table -->