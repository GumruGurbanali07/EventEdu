@using EventEdu.Application.DTOs.Category
@model CreateCategoryDTO

<form asp-area="Admin" asp-controller="Category" asp-action="Create" method="post" enctype="multipart/form-data" >
    <h4 style="margin-left:40px">Add Category</h4>

    <span class="text-danger" asp-validation-summary="all"></span>

    <div class="card-body">
        <!-- Language Dropdown -->
        <div class="form-floating form-floating-outline mb-3">
            <select asp-for="LanguageId" asp-items="ViewBag.Language" class="form-select" aria-label="Choose a Language">
               
            </select>
            <label for="LanguageId">Language</label>
            <span class="form-text text-danger" asp-validation-for="LanguageId"></span>
        </div>

        

        <!-- Category Name (inside CategoryDetails) -->
        <div>
            <label  asp-for="CategoryName" class="form-label">Category Name</label>
            <input type="text" asp-for="CategoryName" class="form-control" placeholder="Enter Category Name">
            <span class="form-text text-danger" asp-validation-for="CategoryName"></span>
        </div>
        <div>
            <label asp-for="FormFile" class="form-label">Upload Files</label>
            <input type="text" asp-for="FormFile" class="form-control" placeholder="Upload file">
            <span class="form-text text-danger" asp-validation-for="FormFile"></span>
        </div>
          

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary mt-3">Save</button>
    </div>
   
</form>