@using EventEdu.Domain.Entities
@model List<CategoryDetail>

@{
    ViewData["Title"] = "Category List";
    var message = TempData["SuccessMessage"];
    var error = TempData["Error"];

}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Category Table</h5>
    <a asp-controller="Category" asp-action="Create" class="btn btn-primary mb-3">Add New Category</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Language</th>
                 
                    <th>Category Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="3" class="text-center">Not Found</td>
                    </tr>
                }
                else
                {
                    @foreach (var category in Model)
                    {
                        <tr class="sponsorRow" style="@(category.IsDeleted ? "background:#d9a7c7; color:#fff;" : "")">
                            <td>@category.LanguageId</td>
                         
                            <td>@category.CategoryName</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="ri-more-2-line"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        @if (category.IsDeleted)
                                        {
                                            <form asp-area="admin" asp-controller="Category" asp-action="DeleteAboutSection" asp-route-id="@category.CategoryId" method="post" onsubmit="return confirm('Are you sure you want to restore this category?');">
                                                <button type="submit" class="dropdown-item"><i class="ri-arrow-go-back-line me-2"></i> Restore</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form  asp-area="admin" asp-controller="Category" asp-action="Update" asp-route-id="@category.Id" method="get">
                                                <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i> Edit</button>
                                            </form>
                                            <form asp-area="admin" asp-controller="Category" asp-action="SoftDeleteCategory" asp-route-id="@category.CategoryId" method="post" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                                <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CSS for Image Styling -->
<style>
    .imgAsAnIcon {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 5px;
    }
</style>

<!-- Testimonial Start -->
@if (!string.IsNullOrEmpty(message as string))
{

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: @Json.Serialize(message),
                duration: 3000,
                gravity: "top", // "top" və ya "bottom"
                position: "right", // "left", "center" və ya "right"
                style:[
                background: "linear-gradient(to right, #4CAF50, #81C784)",  // Success (Green) color

                ]

        ,
            }).showToast();
        });
    </script>
}
@if (!string.IsNullOrEmpty(error as string))
{

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: @Json.Serialize(error),
                duration: 3000,
                gravity: "top", // "top" və ya "bottom"
                position: "right", // "left", "center" və ya "right"
                style:[
                background: "linear-gradient(to right, #4CAF50, #81C784)",  // Success (Green) color

                ]

        ,
            }).showToast();
        });
    </script>
}