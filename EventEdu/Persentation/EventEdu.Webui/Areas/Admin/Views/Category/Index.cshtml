@model List<EventEdu.Application.DTOs.Category.GetCategoryDTO>

@{
    ViewData["Title"] = "Category List";
}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Category Table</h5>
    <a asp-controller="Category" asp-action="AddCategoryWithLanguage" class="btn btn-primary mb-3">Add New Category</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>Category</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var category in Model)
                {
                    if (category.IsDeleted)
                    {
                        <tr class="sponsorRow" style="background:plum; color:#fff;">
                            <td>@category.IsoCode</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@category.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @category.ImagePath)" /></div><span>@category.CategoryName</span></td>

                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Category" asp-action="RestoreCategory" asp-route-id="@category.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this category?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Restore</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="sponsorRow">
                            <td>@category.IsoCode</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@category.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : category.ImagePath)" /></div><span>@category.CategoryName</span></td>

                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Category" asp-action="UpdateCategory" asp-route-id="@category.Id" method="post">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Edit</button>
                                        </form>
                                        <form asp-controller="Category" asp-action="SoftDeleteCategory" asp-route-id="@category.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this category?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!--/ Basic Bootstrap Table -->