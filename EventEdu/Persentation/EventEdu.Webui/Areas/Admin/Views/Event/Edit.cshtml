@using EventEdu.Application.DTOs.Event
@model UpdateEventDTO;

<form asp-area="Admin" asp-controller="Event" asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
    <input type="hidden" value="@Model.Id" />
    <h4 style="margin-left:40px">Edit Event</h4>

    <span class="text-danger" asp-validation-summary="all"></span>

    <div class="card-body">
        <!-- Language Dropdown -->
        <div class="form-floating form-floating-outline mb-3">
            <select asp-for="LanguageId" asp-items="ViewBag.Language" value="LanguageId" class="form-select" aria-label="Choose a Language">
            </select>
            <label for="LanguageId">Language</label>
            <span class="form-text text-danger" asp-validation-for="LanguageId"></span>
        </div>

        
        <!-- Sponsors -->
        <div style="display:flex; gap:1em; flex-wrap:wrap;">
            <label style="display:block; width:100%">Sponsor</label>
            @foreach (var ab in ViewBag.Sponsor)
            {

                var sponsor = ViewBag.EventSponsor.Contains(ab.SponsorId) ? "checked" : "";

                <label style="display:flex;  gap:1em; place-items:center; border: 1px solid; border-radius:12px; padding:10px 14px; background-color:#54b973; color:#d7d7d7">
                    <span>  @ab.SponsorName</span>
                    <input type="checkbox" name="SponsorId" @sponsor value="@ab.SponsorId" />
                </label>
            }
        </div>

        <!-- Speakers -->
        <div style="display:flex; gap:1em; flex-wrap:wrap; margin:12px 0">
            <label style="display:block; width:100%;">Speaker</label>
            @foreach (var a in ViewBag.Speak)
            {
                var speaker = ViewBag.EventSpeaker.Contains(a.SpeakerId) ? "checked" : "";
                <label style="display:flex;  gap:1em; place-items:center; border: 1px solid; border-radius:12px; padding:10px 14px; background-color:#548c73; color:#d7d7d7">

                    <span>@a.FullName</span>
                    <input type="checkbox" name="SpeakerId" @speaker value="@a.SpeakerId" />
                </label>
            }
        </div>


        <!-- Category Name (inside CategoryDetails) -->
        <div>
            <label asp-for="Title" class="form-label"></label>
            <input type="text" asp-for="Title" value="@Model.Title" class="form-control" placeholder="Enter title">
            <span class="form-text text-danger" asp-validation-for="Title"></span>
        </div>

        <div>
            <label asp-for="StartDate" class="form-label"></label>
            <input asp-for="StartDate" value="@Model.StartDate" class="form-control" placeholder="Enter Category Name">
            <span class="form-text text-danger" asp-validation-for="StartDate"></span>
        </div>
        <div>
            <label asp-for="EndDate" class="form-label"></label>
            <input asp-for="EndDate" value="@Model.EndDate" class="form-control" placeholder="Enter Category Name">
            <span class="form-text text-danger" asp-validation-for="EndDate"></span>
        </div>
        <div class="form-floating form-floating-outline mb-3">
            <select asp-for="CategoryId" value="@Model.CategoryId" asp-items="ViewBag.Category" class="form-select" aria-label="Choose a Language">
            </select>
            <label for="CategoryId">Categgory</label>
            <span class="form-text text-danger" asp-validation-for="CategoryId"></span>
        </div>
        <div>
            <img src="~/assets/img/${ImageUrl}" alt="Alternate Text" />
        </div>
        <div>
            <label asp-for="FormFile" class="form-label"></label>
            <input asp-for="FormFile" class="form-control" placeholder="Enter upload images">
            <input type="hidden" name="name" value="ImageUrl" />
            <span class="form-text text-danger" asp-validation-for="FormFile"></span>
        </div>
        <div>
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" value="@Model.Description" class="form-control" placeholder="Enter description " style="resize:none"></textarea>
            <span class="form-text text-danger" asp-validation-for="Description"></span>
        </div>
        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary mt-3">Save</button>
    </div>
    </div>
</form>



