@* @model List<EventEdu.Application.DTOs.Event.GetEventDTO>

@{
    ViewData["Title"] = "Events List";
}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Event Table</h5>
    <a asp-controller="Event" asp-action="AddEvent" class="btn btn-primary mb-3">Add New Event</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>Events</th>
                    <th>Contact Info</th>
                    <th>Website</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var Event in Model)
                {
                    if (Event.IsDeleted)
                    {
                        <tr class="eventRow" style="background:plum; color:#fff;">
                            <td>@Event.IsoCode</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@Event.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @Event.ImagePath)" /></div><span>@Event.EventName</span></td>
                            <td>@Event.Email</td>

                            <td><span class="badge rounded-pill bg-label-primary me-1">@Event.Website</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Event" asp-action="RestoreEvent" asp-route-id="@Event.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this Event?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Restore</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="EventRow">
                            <td>@Event.IsoCode</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@Event.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @Event.ImagePath)" /></div><span>@Event.EventName</span></td>
                            <td>@Event.Email</td>

                            <td><span class="badge rounded-pill bg-label-primary me-1">@Event.Website</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <a asp-controller="Event" asp-action="EditEvent" asp-route-id="@Event.Id" class="dropdown-item">
                                            <i class="ri-pencil-line me-2"></i>Edit
                                        </a>

                                        <form asp-controller="Event" asp-action="DeleteEvent" asp-route-id="@Event.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this Event?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!--/ Basic Bootstrap Table --> *@