@using EventEdu.Application.DTOs.Feedback
@model List<GetFeedbackDTO>

@{
    ViewData["Title"] = "Feedback List";
}

<div class="card">
    <h5 class="card-header">Feedback Table</h5>
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Person Name</th>
                    <th>Event Name</th>
                    <th>Comment</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center">Not Found</td>
                    </tr>
                }
                else
                {
                    @foreach (var feedback in Model)
                    {
                        <tr class="sponsorRow" style="@(feedback.IsDeleted ? "background:#d9a7c7; color:#fff;" : "")">
                            <td>@feedback.FullName</td>
                            <td>@feedback.EventName</td>
                            <td>@feedback.Comment</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="ri-more-2-line"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        @if (feedback.IsDeleted)
                                        {
                                            <form asp-controller="Event" asp-action="Restore" asp-route-id="@feedback.EventId" method="post" onsubmit="return confirm('Are you sure you want to restore this feedback?');">
                                                <button type="submit" class="dropdown-item"><i class="ri-arrow-go-back-line me-2"></i> Restore</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Event" asp-action="Edit" asp-route-id="@feedback.Id" method="get">
                                                <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i> Edit</button>
                                            </form>
                                            <form asp-controller="Event" asp-action="Delete" asp-route-Id="@feedback.EventId" method="post" onsubmit="return confirm('Are you sure you want to delete this feedback?');">
                                                <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
