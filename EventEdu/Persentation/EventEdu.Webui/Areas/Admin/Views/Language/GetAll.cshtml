@model List<EventEdu.Application.DTOs.Language.LanguageGetDTO>

@{
    ViewData["Title"] = "Language List";
}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Language Table</h5>
    <a asp-controller="Language" asp-action="CreateLanguage" class="btn btn-primary mb-3">Add New Language</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>IsoCode</th>
                    <th>Name</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var language in Model)
                {
                    if (language.IsDeleted)
                    {
                        <tr class="sponsorRow" style="background:plum; color:#fff;">
                            <td>@language.IsoCode</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@language.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @language.ImagePath)" /></div><span>@language.Name</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Language" asp-action="Restore" asp-route-id="@language.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this language?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Restore</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="sponsorRow">
                            <td>@language.IsoCode</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@language.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @language.ImagePath)" /></div><span>@language.Name</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <a asp-controller="Language" asp-action="Update" asp-route-id="@language.Id" class="dropdown-item">
                                            <i class="ri-pencil-line me-2"></i>Edit
                                        </a>

                                        <form asp-controller="Language" asp-action="SoftDelete" asp-route-id="@language.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this language?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!--/ Basic Bootstrap Table -->