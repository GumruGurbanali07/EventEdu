
@model List<Language>;



<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Language Table</h5>
    <a asp-controller="Language" asp-action="Create" class="btn btn-primary mb-3">Add New lang</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Id </th>
                 
                    <th>Name</th>
                    <th>Iso Code </th>
                    <th> Actions </th>

                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center">Not Found</td>
                    </tr>
                }
                else
                {
                  
                    @foreach (var lang in Model)
                    {
                        <tr class="sponsorRow" style="@(lang.IsDeleted ? "background:#d9a7c7; color:#fff;" : "")">
                            <td>@lang.Id</td>

                            <td>@lang.Name</td>
                            <td>@lang.IsoCode</td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown">
                                        <i class="ri-more-2-line"></i>
                                    </button>
                                    <div class="dropdown-menu">
                                        @if (lang.IsDeleted)
                                        {
                                            <form asp-controller="lang" asp-action="RestoreCategory" asp-route-id="@lang.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this lang?');">
                                                <button type="submit" class="dropdown-item"><i class="ri-arrow-go-back-line me-2"></i> Restore</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-controller="Language" asp-action="Edit" asp-route-id="@lang.Id" method="post">
                                                <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i> Edit</button>
                                            </form>
                                            <form asp-controller="Language" asp-action="SoftDeleteCategory" asp-route-categoryId="@lang." method="post" onsubmit="return confirm('Are you sure you want to delete this lang?');">
                                                <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                            </form>
                                        }
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- CSS for Image Styling -->
<style>
    .imgAsAnIcon {
        width: 50px;
        height: 50px;
        object-fit: cover;
        border-radius: 5px;
    }
</style>