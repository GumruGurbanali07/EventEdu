@using EventEdu.Application.DTOs.Speaker
@model CreateSpeakerDTO

<form asp-controller="Speaker" asp-action="Create" method="post" enctype="multipart/form-data">
    <h4 style="margin-left:40px">Add Speaker</h4>

    <div class="addOrEditCard card">
        <!-- Image Preview -->
        <div class="chosenImage">
            <img id="imagePreview" src="~/client/assets/img/teams/team-2.jpg" alt="Speaker Image" />
        </div>

        <div class="card-body">
            <!-- Language Dropdown -->
            <div class="form-floating form-floating-outline mb-3">
                <select asp-for="LanguageId" class="form-select" asp-items="@ViewBag.Language" aria-label="Choose a Language">
             
                </select>
                <label for="LanguageId">Language</label>
                <span class="form-text text-danger" asp-validation-for="LanguageId"></span>
            </div>

            <!-- File Input for Image -->
            <div class="mb-3">
                <label asp-for="FormFile" class="form-label">Speaker's Image</label>
                <input class="form-control" type="file" asp-for="FormFile" id="ImageFile">
                <span class="form-text text-danger" asp-validation-for="FormFile"></span>
            </div>

            <!-- Speaker Name (inside SpeakerDetails) -->
            <div>
                <label asp-for="FullName" class="form-label">Speaker Name</label>
                <input type="text" asp-for="FullName" class="form-control" placeholder="Enter Speaker Name">
                <span class="form-text text-danger" asp-validation-for="FullName"></span>
            </div>

            <!-- Speaker Bio -->
            <div>
                <label asp-for="Bio" class="form-label">Speaker Description</label>
                <textarea asp-for="Bio" class="form-control" placeholder="Enter Speaker Bio"></textarea>
                <span class="form-text text-danger" asp-validation-for="Bio"></span>
            </div>

            <!-- Email -->
            <div>
                <label asp-for="Email" class="form-label">Email</label>
                <input type="email" asp-for="Email" class="form-control" placeholder="Enter Email">
                <span class="form-text text-danger" asp-validation-for="Email"></span>
            </div>
            <div>
                <label asp-for="FacebookLink" class="form-label"></label>
                <input  asp-for="FacebookLink" class="form-control" placeholder="Enter Email">
                <span class="form-text text-danger" asp-validation-for="FacebookLink"></span>
            </div>
            <div>
                <label asp-for="InstagramLink" class="form-label"></label>
                <input asp-for="InstagramLink" class="form-control" placeholder="Enter Email">
                <span class="form-text text-danger" asp-validation-for="InstagramLink"></span>
            </div>
            <div>
                <label asp-for="TwitterLink" class="form-label"></label>
                <input asp-for="TwitterLink" class="form-control" placeholder="Enter Email">
                <span class="form-text text-danger" asp-validation-for="TwitterLink"></span>
            </div>
            <!-- Submit Button -->
            <button type="submit" class="btn btn-primary mt-3">Save</button>
        </div>
    </div>
</form>

<!-- Image Preview Script -->

