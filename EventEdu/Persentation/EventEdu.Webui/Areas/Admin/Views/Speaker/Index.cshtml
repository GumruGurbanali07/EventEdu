@using EventEdu.Webui.ViewsModels
@model SpeakerIndexVM;

@{
    ViewData["Title"] = "Speakers List";
}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Speaker Table</h5>
    <a asp-controller="Speaker" asp-action="Create" class="btn btn-primary mb-3">Add New Speaker</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>Speakers</th>
                    <th>Bio</th>
                    <th>Contact info</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var Speaker in Model.Speakers)
                {
                    if (Speaker.IsDeleted)
                    {
                        <tr class="SpeakerRow" style="background:plum; color:#fff;">
                            <td>@Model.SpeakerDetail.LanguageId</td>
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(Speaker.ImageUrl) ? "~/client/assets/img/default-jpg.jpg" : @Speaker.ImageUrl)" /></div><span>@Model.SpeakerDetail.FullName</span></td>
                            <td>@Model.SpeakerDetail.Bio</td>

                            <td><span class="badge rounded-pill bg-label-primary me-1">@Speaker.Email</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Speaker" asp-action="RestoreSpeaker" asp-route-id="@Speaker.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this speaker?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Restore</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="SpeakerRow">
                            <td>@Model.SpeakerDetail.LanguageId</td>

                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(Speaker.ImageUrl) ? "~/client/assets/img/default-jpg.jpg" :"/assets/img/"+ @Speaker.ImageUrl)" /></div><span>@Model.SpeakerDetail.FullName</span></td>
                            <td>@Model.SpeakerDetail.Bio</td>

                            <td><span class="badge rounded-pill bg-label-primary me-1">@Speaker.Email</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Speaker" asp-action="Edit" asp-route-id="@Speaker.Id" method="get">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Edit</button>
                                        </form>
                                        <form asp-controller="Speaker" asp-action="Delete" asp-route-id="@Speaker.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this speaker?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!--/ Basic Bootstrap Table -->