@model List<EventEdu.Application.DTOs.Sponsor.GetSponsorDTO>

@{
    ViewData["Title"] = "Sponsors List";
}


<!-- Basic Bootstrap Table -->
<div class="card">
    <h5 class="card-header">Sponsor Table</h5>
    <a href="@Url.Action("AddSponsor", "Sponsor")" class="btn btn-primary mb-3">Add New Sponsor</a>

    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>Language</th>
                    <th>Sponsors</th>
                    <th>Contact Info</th>
                    <th>Website</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var sponsor in Model)
                {
                    if (sponsor.IsDeleted)
                    {
                        <tr>@sponsor.IsoCode</tr>
                        <tr class="sponsorRow" style="background:plum; color:#fff;">
                            <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@sponsor.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @sponsor.ImagePath)" /></div><span>@sponsor.SponsorName</span></td>
                            <td>@sponsor.Email</td>

                            <td><span class="badge rounded-pill bg-label-primary me-1">@sponsor.Website</span></td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                                    <div class="dropdown-menu">
                                        <form asp-controller="Sponsor" asp-action="RestoreSponsor" asp-route-id="@sponsor.Id" method="post" onsubmit="return confirm('Are you sure you want to restore this sponsor?');">
                                            <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Restore</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        <tr class="sponsorRow">
                        <tr>@sponsor.IsoCode</tr>
                    <td style="display:flex; gap:5px;align-items:center;"><div class="imgAsAnIconContent"><img class="imgAsAnIcon" src="@(string.IsNullOrEmpty(@sponsor.ImagePath) ? "~/client/assets/img/default-jpg.jpg" : @sponsor.ImagePath)" /></div><span>@sponsor.SponsorName</span></td>
                    <td>@sponsor.Email</td>

                    <td><span class="badge rounded-pill bg-label-primary me-1">@sponsor.Website</span></td>
                    <td>
                        <div class="dropdown">
                            <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown"><i class="ri-more-2-line"></i></button>
                            <div class="dropdown-menu">
                                <form asp-controller="Sponsor" asp-action="EditSponsor" asp-route-id="@sponsor.Id" method="post">
                                    <button type="submit" class="dropdown-item"><i class="ri-pencil-line me-2"></i>Edit</button>
                                </form>
                                <form asp-controller="Sponsor" asp-action="DeleteSponsor" asp-route-id="@sponsor.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this sponsor?');">
                                    <button type="submit" class="dropdown-item"><i class="ri-delete-bin-6-line me-2"></i> Delete</button>
                                </form>
                            </div>
                        </div>
                    </td>
                    </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
<!--/ Basic Bootstrap Table -->