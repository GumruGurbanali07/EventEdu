<!-- Event Data (Hidden for JS) -->
<div id="eventData" data-description="@Model.Description"
     data-image="~/client/assets/img/teams/team-1.jpg"></div>

<div id="sponsorData" class="sponsor-section"
     data-description="This event is proudly sponsored by leading companies...">
    <!-- Asagidaki kommiti acsam data-image i kommente at-->
    data-image="~/client/assets/img/sponsors/sponsor-1.jpg">

   @*  @if (Model.Sponsors != null && Model.Sponsors.Count > 1)
    {
        <i class="fa fa-chevron-left img-nav left-arrow" id="prevSponsor" style="cursor: pointer;"></i>
    }

    <div class="sponsor-img-container">
        @for (int i = 0; i < Model.Sponsors.Count; i++)
        {
            var sponsor = Model.Sponsors[i];
            <img src="@sponsor.ImageUrl"
                 class="sponsor-image @(i == 0 ? "active" : "hidden")"
                 data-index="@i" />
        }
    </div>

    @if (Model.Sponsors != null && Model.Sponsors.Count > 1)
    {
        <i class="fa fa-chevron-right img-nav right-arrow" id="nextSponsor" style="cursor: pointer;"></i>
    } *@
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const buttons = document.querySelectorAll(".about-nav.toggle-btn, .language-nav.toggle-btn");
        const descriptionText = document.getElementById("descriptionText");
        const infoImage = document.getElementById("infoImage");

        const eventData = document.getElementById("eventData");
        const sponsorData = document.getElementById("sponsorData");

        buttons.forEach(button => {
            button.addEventListener("click", function () {
                buttons.forEach(btn => btn.classList.remove("active"));
                this.classList.add("active");

                const target = this.getAttribute("data-target");

                if (target === "sponsor") {
                    descriptionText.innerHTML = sponsorData.getAttribute("data-description");
                    infoImage.src = sponsorData.getAttribute("data-image");
                } else {
                    descriptionText.innerHTML = eventData.getAttribute("data-description");
                    infoImage.src = eventData.getAttribute("data-image");
                }
            });
        });
    });

