@using EventEdu.Application.DTOs.Event
@model GetEventDTO

<!-- Event Image -->
<div class="banner event-banner">
    <img src="~/client/assets/img/teams/team-1.jpg" id="displayedImage" />
</div>

<div class="eventDetail-buttons">
    <i id="shareBtn" class="fa-solid fa-share"></i>
</div>

<!-- Modal Structure -->
<div id="shareModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Share This Page</h2>
        <p>Copy the URL below:</p>
        <input type="text" id="pageUrl" readonly>
    </div>
</div>

<!-- Event / Sponsor Section -->
<div class="about-event">
    <div class="about">
        <div class="about-navigation">
            <div class="about-nav toggle-btn active" data-target="event" style="cursor: pointer;">
                <span>Tədbir haqqında</span>
            </div>
            <div class="language-nav toggle-btn" data-target="sponsor" style="cursor: pointer;">
                <span>Sponsor</span>
            </div>
        </div>

        <div class="event-description" id="descriptionText">
            <span>@Model.Description</span>
        </div>
    </div>
    <div class="event-img-wrapper">
        <!-- Asagidaki kommiti acsam data-image i kommente at-->
        <div class="event-img">
            <img src="~/client/assets/img/teams/team-1.jpg" id="infoImage" />
        </div>
      @*   @if (Model.Speakers != null && Model.Speakers.Count > 1)
        {
            <i class="fa fa-chevron-left img-nav left-arrow" id="prevSpeaker" style="cursor: pointer;"></i>
        }

        <div class="event-img">
            @for (int i = 0; i < Model.Speakers.Count; i++)
            {
                var speaker = Model.Speakers[i];
                <img src="@speaker.ImageUrl"
                     class="infoImage speaker-image @(i == 0 ? "active" : "hidden")"
                     data-index="@i" />
            }
        </div>

        @if (Model.Speakers != null && Model.Speakers.Count > 1)
        {
            <i class="fa fa-chevron-right img-nav right-arrow" id="nextSpeaker" style="cursor: pointer;"></i>
        } *@
    </div>

</div>

