@using EventEdu.Webui.ViewsModels

@model EventSpeakerVM

<!-- Event Image -->
<div class="banner event-banner">
    <img src="/assets/img/@Model.GetEventDTO.ImageUrl" id="displayedImage" />
</div>

<div class="eventDetail-buttons">
    <i id="shareBtn" class="fa-solid fa-share"></i>
</div>

<!-- Modal Structure -->
<div id="shareModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Share This Page</h2>
        <p>Copy the URL below:</p>
        <input type="text" id="pageUrl" readonly>
    </div>
</div>

<!-- Event / Sponsor Section -->
<div class="about-event">
    <div class="about">
        <div class="about-navigation">
            <div class="about-nav toggle-btn active" data-target="event" style="cursor: pointer;">
                <span>Tədbir haqqında</span>
            </div>
            <div class="language-nav toggle-btn" data-target="sponsor" style="cursor: pointer;">
                <span>Sponsor</span>
            </div>
        </div>

        <div class="event-description" id="descriptionText">
            <span>@Model.GetEventDTO.Description</span>
        </div>
    </div>
    <div class="event-img-wrapper">
        <!-- Asagidaki kommiti acsam data-image i kommente at-->
        <div class="event-img">
            <img src="~/assets/img/@Model.GetEventDTO.ImageUrl" id="infoImage" />
        </div>

    </div>

</div>


<!-- Event Data (Hidden for JS) -->
<div id="eventData" data-description="@Model.GetEventDTO.Description"></div>

</div>


<div>
     <textarea style="resize:none; width:140px;  " data-id="@Model.Speaker."></textarea>
</div>

<div class="container-xxl py-5" style="height:100vh">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Speakers</h6>
            <h1 class="mb-5">Expert Speakers</h1>
        </div>
        <div class="row g-4">
            @foreach (var speaker in Model.Speaker)
            {



                var detail = Model.SpeakerDetail.FirstOrDefault(sd => sd.SpeakerId == speaker.Id);

                <div class="col-lg-3 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="team-item bg-light">
                        <div class="overflow-hidden">
                            <img class="img-fluid" src="/assets/img/@speaker.ImageUrl" alt="">
                        </div>
                        <div class="position-relative d-flex justify-content-center" style="margin-top: -23px;">
                            <div class="bg-light d-flex justify-content-center pt-2 px-1">
                                <a class="btn btn-sm-square btn-primary mx-1" href="@speaker.FacebookLink"><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-sm-square btn-primary mx-1" href="@speaker.TwitterLink"><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-sm-square btn-primary mx-1" href="@speaker.InstagramLink"><i class="fab fa-instagram"></i></a>
                            </div>
                        </div>
                        <div class="text-center p-4">
                            @if (detail != null)
                            {
                                <h5 class="mb-0">@detail.FullName</h5>
                            }
                            else
                            {
                                <h5 class="mb-0">No name</h5>
                            }
                        </div>
                    </div>
                </div>
            }
            }
        </div>
    </div>
</div>



