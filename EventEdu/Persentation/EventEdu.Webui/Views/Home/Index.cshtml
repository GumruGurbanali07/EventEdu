@using EventEdu.Webui.ViewsModels
@model HomeIndexVM


@{
    var message = ViewData["Success"];
    var localizer = ViewBag.Localizer as IStringLocalizer<HomeController>;




}

<div class="container-fluid p-0 mb-5">
    <div class="owl-carousel header-carousel position-relative">
        @foreach (var slider in Model.HeroSections)
        {
            <div class="owl-carousel-item position-relative">
                <img class="img-fluid" src="@slider.ImagePath" alt="">
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center" style="background: rgba(24, 29, 56, .7);">
                    <div class="container">
                        <div class="row justify-content-start">
                            <div class="col-sm-10 col-lg-8">
                                <h5 class="text-primary text-uppercase mb-3 animated slideInDown"></h5>

                                    <h1 class="display-3 text-white animated slideInDown">@slider.HeroSectionDetails.FirstOrDefault().Title</h1>
                                    <p class="fs-5 text-white mb-4 pb-2">
                                        @slider.HeroSectionDetails.FirstOrDefault().Description
                                    </p>
                                }

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Carousel End -->




<!-- Service Start -->
@await Component.InvokeAsync("Category")
<!-- Service End -->



<!-- About Start -->
@await Component.InvokeAsync("About");
<!-- About End -->
<!-- Categories Start -->
<div class="container-xxl py-5 category">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Categories</h6>
            <h1 class="mb-5">Courses Categories</h1>
        </div>

<div class="row g-3">
    <div class="col-lg-7 col-md-6">
        <div class="row g-3">
            @foreach (var category in Model.CategoryDetails.Take(3)) // First three categories
            {
                        <div class="col-lg-@(category == Model.CategoryDetails.First() ? "12" : "6") col-md-12 wow zoomIn" data-wow-delay="0.1s">
                    <a class="position-relative d-block overflow-hidden" href="">
                                <img class="img-fluid" src="@category.ImagePath" alt="@category.CategoryName">
                        <div class="bg-white text-center position-absolute bottom-0 end-0 py-2 px-3" style="margin: 1px;">
                                    <h5 class="m-0">@category.CategoryName</h5>
                            <small class="text-primary">Count Courses</small>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5 col-md-6 wow zoomIn" data-wow-delay="0.7s" style="min-height: 350px;">
                @if (Model.CategoryDetails.Count > 3)
        {
                    var category = Model.CategoryDetails[3]; // Fourth category
            <a class="position-relative d-block h-100 overflow-hidden" href="">
                        <img class="img-fluid position-absolute w-100 h-100" src="@category.ImagePath" alt="@category.CategoryName" style="object-fit: cover;">
                <div class="bg-white text-center position-absolute bottom-0 end-0 py-2 px-3" style="margin: 1px;">
                            <h5 class="m-0">@category.CategoryName</h5>
                            <small class="text-primary">Courses</small>
                </div>
            </a>
        }
    </div>
</div>

    </div>
</div>
<!-- Categories Start -->
<!-- Courses Start -->
<div class="container-xxl py-5">
    <div class="container">
        <div class="text-center wow fadeInUp" data-wow-delay="0.1s">
            <h6 class="section-title bg-white text-center text-primary px-3">Events</h6>
            <h1 class="mb-5">Last Events</h1>
        </div>

        <div class="row g-4 justify-content-center">
            @* Row is now outside the loop *@
            @foreach (var eevent in Model.Events.OrderByDescending(e => e.Id).Take(3))
            {
                <div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
                    <div class="course-item bg-light">
                        <div class="position-relative overflow-hidden">
                            <img class="img-fluid" src="~/client/assets/img/courses/course-1.jpg" alt="">
                            <div class="w-100 d-flex justify-content-center position-absolute bottom-0 start-0 mb-4">
                                <a href="#" class="flex-shrink-0 btn btn-sm btn-primary px-3 border-end" style="border-radius: 30px 0 0 30px;">Registration</a>
                                <a asp-controller="Event" asp-action="EventDetail" asp-route-id="@eevent.Id" class="flex-shrink-0 btn btn-sm btn-primary px-3" style="border-radius: 0 30px 30px 0;">Feedback</a>
                            </div>
                        </div>
                        <div class="text-center p-4 pb-0">
                            <h3 class="mb-0">@eevent.EventDetails.FirstOrDefault()?.Title</h3>
                        @*     <div class="mb-3">
                                <small class="fa fa-star text-primary"></small>
                                <small class="fa fa-star text-primary"></small>
                                <small class="fa fa-star text-primary"></small>
                                <small class="fa fa-star text-primary"></small>
                                <small class="fa fa-star text-primary"></small>
                                <small>(123)</small>
                            </div> *@
                        </div>
                        <div class="text-center my-3">
                            <a asp-controller="Event" asp-action="EventDetail" asp-route-id="@eevent.Id" class="btn btn-primary">View Details</a>
                        </div>
                        <div class="d-flex border-top">
                            <small class="flex-fill text-center border-end py-2">
                                <i class="fa fa-calendar text-primary me-2"></i>@eevent.StartDate.ToString("dd MMM yyyy")
                            </small>
                            <small class="flex-fill text-center border-end py-2">
                                <i class="fa fa-clock text-primary me-2"></i>@eevent.StartDate.ToString("HH:mm") - @eevent.EndDate.ToString("HH:mm")
                            </small>
                        </div>
                    </div>
                </div>
            }
        </div> @* Closing the row properly *@
    </div>
</div>


<!-- Courses End -->
<!-- Team Start -->
@await Component.InvokeAsync("Speaker")

@await Component.InvokeAsync("Sponsor")
<!-- Testimonial Start -->


    @if (!string.IsNullOrEmpty(message as string))
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                Toastify({
                    text: @Json.Serialize(message),
                    duration: 3000,
                    gravity: "top", // "top" və ya "bottom"
                    position: "right", // "left", "center" və ya "right"
                    backgroundColor: "linear-gradient(to right, #FF0000 )",
                }).showToast();
            });
        </script>
    }<!-- Testimonial End -->
