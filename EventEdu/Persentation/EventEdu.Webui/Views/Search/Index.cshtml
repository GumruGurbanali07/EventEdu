@using EventEdu.Webui.ViewsModels.SearchVM
@model SearchVM

<h2>Search Results</h2>

@if (!Model.Events.Any() && !Model.Sponsors.Any() && !Model.Speakers.Any())
{
    <p>No results found.</p>
}
else
{
    @* <h3>Events</h3> *@
@*     <ul>
        @foreach (var ev in Model.Events)
        {
            <li><a href="@Url.Action("Details", "Event", new { id = ev.Id })">@ev.Name</a></li>
        }
    </ul> *@

    <h3>Sponsors</h3>
    <ul>
        @foreach (var sponsor in Model.Sponsors)
        {
            <li><a href="@Url.Action("Details", "Sponsor", new { id = sponsor.Id })">@sponsor.SponsorsDetail.FirstOrDefault().SponsorName</a></li>
        }
    </ul>

    @* <h3>Speakers</h3>
    <ul>
        @foreach (var speaker in Model.Speakers)
        {
            <li><a href="@Url.Action("Details", "Speaker", new { id = speaker.Id })">@speaker.Name</a></li>
        }
    </ul> *@
}
