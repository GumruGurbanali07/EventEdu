@using EventEdu.Webui.ViewsModels
@model CategoryLanguageVM
@using Microsoft.Extensions.Localization
@inject IStringLocalizer JsonLocalizer

<nav class="navbar navbar-expand-lg bg-white navbar-light shadow sticky-top p-0">
    <a asp-controller="Home" asp-action="Index" class="navbar-brand d-flex align-items-center px-4 px-lg-5">
        <h2 class="m-0 text-primary"><i class="fa fa-book me-3"></i>EventADA</h2>
    </a>
    <button type="button" class="navbar-toggler me-4" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse " id="navbarCollapse">
        <div class="navbar-nav ms-auto p-4 p-lg-0">
            <a asp-controller="Home" asp-action="Index" class="nav-item nav-link active">@JsonLocalizer["Home"]</a>
            <a asp-controller="About" asp-action="Index" class="nav-item nav-link">@JsonLocalizer["About"]</a>
            <a asp-controller="Sponsor" asp-action="Index" class="nav-item nav-link">@JsonLocalizer["Sponsors"]</a>
            <div class="nav-item dropdown">
                <a asp-controller="Event" asp-action="Index" class="nav-link dropdown-toggle d-flex" data-bs-toggle="dropdown">@JsonLocalizer["Events"]</a>
                <div class="d-flex flex-column">
                    <ul class="dropdown-menu" aria-labelledby="Dropdown">
                        <li>
                            <a class="dropdown-item" asp-controller="Event" asp-action="Technology">Technology</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Event" asp-action="Business">Business</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Event" asp-action="Science">Science</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Event" asp-action="Startup">Startup</a>
                        </li>
                        <li>
                            <a class="dropdown-item" asp-controller="Event" asp-action="Education">Education</a>
                        </li>
                    </ul>
                </div>
                @* <div class="d-flex flex-column">
                    <ul class="dropdown-menu" aria-labelledby="Dropdown">

                        @foreach (var c in Model.CategoryDetails)
                        {
                            <li>
                                <a class="dropdown-item" asp-controller="Event" asp-action="@c.CategoryName">@c.CategoryName</a>
                            </li>
                        }


                    </ul>
                </div> *@

            </div>
        </div>

        <div class="nav-item dropdown d-flex">
            <div class="currentLangFlag"><img class="flag" src="~/client/assets/img/flags/english.svg" alt=""></div>
            <a data-mdb-dropdown-init class="dropdown-toggle" href="#" id="Dropdown" role="button" data-mdb-toggle="dropdown" aria-expanded="false">
                <i class="flag-united-kingdom flag m-0"></i>
            </a>
            <ul class="dropdown-menu mt-4" aria-labelledby="Dropdown">

                @foreach (var ln in Model.Languages)
                {
                    <li>

                        <a class="dropdown-item" asp-controller="Language" asp-action="Change" asp-route-lang="@ln.IsoCode">
                            @ln.ImagePath
                        </a>
                    </li>
                }



            </ul>
        </div>


        <div class="searchbar">
            <input id="searchInput" placeholder="Search products" type="text">
            <span id="magnifying-glass"><i class="fa-solid fa-magnifying-glass"></i></span>
        </div>
        <div id="searchBody">
            <!-- Results will be rendered here -->
        </div>
    </div>
</nav>
<!-- Navbar End -->
