@using EventEdu.Webui.ViewsModels
@model SponsIndexVM

<div class="container-xxl py-5 wow fadeInUp" data-wow-delay="0.1s">
    <div class="container">
        <div class="text-center">
            <h6 class="section-title bg-white text-center text-primary px-3">Testimonial</h6>
            <h1 class="mb-5">Our Sponsors Here!</h1>
        </div>

        <!-- Carousel konteynerini foreach-in çölündə saxlayırıq -->
        <div class="owl-carousel testimonial-carousel position-relative">
            @foreach (var sponsor in Model.Sponsors)
            {
                <div class="testimonial-item text-center">
                    <img class="border rounded-circle p-2 mx-auto mb-3" src="/assets/img/@sponsor.ImagePath" style="width: 80px; height: 80px;">
                    <h5 class="mb-0">@Model.SponsorDetail.SponsorName</h5>
                    <p>@sponsor.Email</p>
                    <div class="testimonial-text bg-light text-center p-4">
                        <p class="mb-0">@Model.SponsorDetail.SponsorDescription</p>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
