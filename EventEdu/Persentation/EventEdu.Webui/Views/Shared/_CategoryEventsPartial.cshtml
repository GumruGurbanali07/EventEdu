@* @using EventEdu.Application.DTOs.Event *@
@using EventEdu.Domain.Entities
@model List<Event>

<div class="Events">
    @foreach (var eventItem in Model)
    {
        <a asp-controller="event" asp-action="eventDetail" class="eventSlide eventSlide-item expired">
            <div class=" testimonial-item text-center">
                <img class="border rounded-circle p-2 mx-auto mb-3" src="~/assets/img/@eventItem.ImageUrl" style="width: 80px; height: 80px;">
                <h5 class="mb-0">@eventItem.EventDetails.FirstOrDefault().Title</h5>
                @* <p>eve</p> *@
                <div class="testimonial-text bg-light text-center p-4">
                    <p class="mb-0">@eventItem.EventDetails.FirstOrDefault().Description</p>
                </div>
            </div>
        </a>
    }
</div>

<div class="Events" id="eventContainer">
    <!-- Event slides will be dynamically controlled -->
</div>

@if (Model.Count >= 20)
{
    <div class="pagination">
        <button class="prevEventBtn" disabled>Previous</button>
        <button class="nextEventBtn">Next</button>
    </div>
}
