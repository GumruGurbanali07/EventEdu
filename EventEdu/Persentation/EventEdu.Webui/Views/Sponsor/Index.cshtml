@using EventEdu.Webui.ViewsModels.Sponsors
@model List<SponsorVM>
<div class="container slider-container">
    <div class="slides">
        @for (int i = 0; i < (int)Math.Ceiling((double)Model.Count / 6); i++)
        {
            <div class="slide">
                <!-- Testimonial Start -->
                <div class="mt-5 d-flex flex-column gap-5 " data-wow-delay="0.1s">
                    @for (int j = 0; j < 2; j++)
                    {
                            int sponsorsPerLine = 3;
                            int totalLines = (int)Math.Ceiling((double)Model.Count() / sponsorsPerLine);
                            int currentLine = 1;

                        int skipCount = (currentLine - 1) * sponsorsPerLine;

                        var lineSponsors = Model.Skip(skipCount).Take(sponsorsPerLine);

                        <div class=" Line d-flex justify-content-between">
                            @foreach (var sponsor in lineSponsors)
                            {
                                <div class="testimonial-item text-center">
                                    <img class="border rounded-circle p-2 mx-auto mb-3" src="@sponsor.ImagePath" style="width: 80px; height: 80px;">
                                    <h5 class="mb-0">@sponsor.Name</h5>
                                    <p>@sponsor.Email</p>
                                    <div class="testimonial-text bg-light text-center p-4">
                                        <p class="mb-0">@sponsor.Description</p>
                                    </div>
                                </div>

                            }
                        </div>

                    }


                </div>
                <!-- Testimonial End -->
            </div>
        }
    </div>
</div>
<div class="prev" onclick="moveSlide(-1)"><i class="fa-solid fa-chevron-left"></i></div>
<div class="next" onclick="moveSlide(1)"><i class="fa-solid fa-chevron-right"></i></div>