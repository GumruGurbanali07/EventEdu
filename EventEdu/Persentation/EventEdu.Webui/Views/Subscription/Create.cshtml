@{
    var message = TempData["Error"];
}




@using EventEdu.Application.DTOs.Subscription
@model  SubscribeDTO 

<form asp-controller="Subscription" asp-action="Create" asp-route-eventId="@ViewBag.Event" method="post" style="margin:40px 0; gap:1em;display:flex; place-content:center; place-items:center; flex-direction:column">





    <!-- Category Name (inside CategoryDetails) -->
    <div>
        <label asp-for="FirstName" class="form-label"></label>
        <input type="text" asp-for="FirstName" class="form-control" placeholder="Enter FirstName ">
        <span class="form-text text-danger" asp-validation-for="FirstName"></span>
    </div>
    <div>
        <label asp-for="LastName" class="form-label"> </label>
        <input type="text" asp-for="LastName" class="form-control" placeholder="Enter LastName ">
        <span class="form-text text-danger" asp-validation-for="LastName"></span>
    </div>
    <div>
        <label asp-for="Email" class="form-label"></label>
        <input type="email" asp-for="Email" class="form-control" placeholder="Enter Email">
        <span class="form-text text-danger" asp-validation-for="Email"></span>
    </div>

    <!-- Submit Button -->
    <button type="submit" class="btn btn-primary mt-3">Save</button>
    </div>

</form>


@if (!string.IsNullOrEmpty(message as string))
{
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            Toastify({
                text: @Json.Serialize(message), 
                duration: 3000,
                gravity: "top", // "top" və ya "bottom"
                position: "right", // "left", "center" və ya "right"
                background: "linear-gradient(to right, #FF0000 )",
            }).showToast();
        });
    </script>
}